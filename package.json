{
  "name": "llm-parser",
  "version": "0.0.1",
  "description": "A local structured-output reliability demo for browser LLMs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "node scripts/deploy.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@huggingface/transformers-structured-output": "^4.3.0",
    "lucide-react": "latest",
    "prismjs": "^1.30.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tailwindcss/vite": "latest",
    "@trivago/prettier-plugin-sort-imports": "latest",
    "@types/prismjs": "^1.26.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "typescript": "^6.0.2",
    "typescript-eslint": "latest",
    "vite": "latest"
  }
}
